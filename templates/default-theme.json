  "sources": {
    "componentDirs": ["components", "src/components", "app/components"],
    "pageDirs": ["app", "src/app", "pages", "src/pages"],
    "dataDirs": ["data", "src/data", "content", "lib/data"],
    "uiPrimitiveDirs": ["components/ui", "src/components/ui"]
  },

  "mappings": [
    {
      "id": "components",
      "kind": "component",
      "description": "React section components become components/<Name>/<Name>.tsx with a generated component.json.",
      "match": ["components/**/*.{tsx,jsx}", "src/components/**/*.{tsx,jsx}", "app/components/**/*.{tsx,jsx}"],
      "ignore": ["**/*.test.*", "**/*.spec.*", "**/*.stories.*", "components/ui/**", "src/components/ui/**"],
      "target": "components/{ComponentName}/{ComponentName}{ext}"
    },
    {
      "id": "icons",
      "kind": "icon",
      "description": "SVG icons keep their sub-folder under assets/icons.",
      "match": ["public/**/*.svg", "static/**/*.svg", "src/assets/**/*.svg", "assets/**/*.svg"],
      "stripPrefix": ["public/", "static/", "src/assets/", "assets/"],
      "target": "assets/icons/{relativeDir}/{basename}"
    },
    {
      "id": "images",
      "kind": "image",
      "description": "Images keep their sub-folder grouping (public/hero/banner.webp -> assets/hero/banner.webp). Spaces in folder or file names become hyphens.",
      "match": [
        "public/**/*.{png,jpg,jpeg,webp,gif,avif,jfif,bmp,ico}",
        "static/**/*.{png,jpg,jpeg,webp,gif,avif,jfif,bmp,ico}",
        "src/assets/**/*.{png,jpg,jpeg,webp,gif,avif,jfif,bmp,ico}",
        "assets/**/*.{png,jpg,jpeg,webp,gif,avif,jfif,bmp,ico}"
      ],
      "stripPrefix": ["public/", "static/", "src/assets/", "assets/"],
      "target": "assets/{relativeDir}/{basename}"
    },
    {
      "id": "media",
      "kind": "other",
      "description": "Video/audio assets.",
      "match": ["public/**/*.{mp4,webm,mp3,ogg}", "static/**/*.{mp4,webm,mp3,ogg}"],
      "stripPrefix": ["public/", "static/"],
      "target": "assets/media/{relativeDir}/{basename}"
    }
  ],

  "exclude": {
    "directories": [
      "node_modules", ".git", ".next", ".nuxt", ".svelte-kit", "dist", "build", "out", ".vercel",
      ".turbo", "coverage", ".cache", ".idea", ".vscode", "__pycache__", ".husky", ".github"
    ],
    "files": [
      "**/.env", "**/.env.*", "**/*.pem", "**/*.key", "**/*.p12", "**/*.pfx", "**/*.crt", "**/*.cer",
      "**/id_rsa*", "**/id_ed25519*", "**/.npmrc", "**/.yarnrc", "**/.netrc", "**/*secret*", "**/*credential*",
      "**/*.zip", "**/*.tar", "**/*.gz", "**/*.tgz", "**/*.7z", "**/*.rar",
      "**/*.exe", "**/*.dll", "**/*.msi", "**/*.bat", "**/*.cmd", "**/*.ps1", "**/*.sh",
      "**/package-lock.json", "**/yarn.lock", "**/pnpm-lock.yaml", "**/bun.lockb", "**/*.log",
      "**/.DS_Store", "**/Thumbs.db"
    ],
    "boilerplateAssets": [
      "public/next.svg", "public/vercel.svg", "public/file.svg", "public/globe.svg", "public/window.svg",
      "public/favicon.ico", "app/favicon.ico", "src/app/favicon.ico"
    ],
    "secretContentPatterns": [
      "-----BEGIN [A-Z ]*PRIVATE KEY-----",
      "\\bghp_[A-Za-z0-9]{36}\\b",
      "\\bgithub_pat_[A-Za-z0-9_]{60,}\\b",
      "\\bsk-[A-Za-z0-9_-]{32,}\\b",
      "\\bAKIA[0-9A-Z]{16}\\b",
      "\\bxox[baprs]-[A-Za-z0-9-]{10,}\\b"
    ]
  },

  "conflicts": {
    "policy": "rename",
    "renamePattern": "{stem}-{n}{ext}",
    "existingOutputPolicy": "replace"
  },

  "transformations": {
    "renameComponentIdentifier": true,
    "rewriteSiblingImports": true,
    "rewriteAssetPaths": true,
    "extractEditorFields": true,
    "resolveDefaultContent": true,
    "ensureDefaultExport": true,
    "appendEditorFieldsStatic": true,
    "editorFieldsFromDefaultContent": true,
    "fillMissingEditorFields": true,
    "skipComponentsWithoutEditorFields": true,
    "seedFieldShapes": true,
    "excludeEditorFields": ["id", "slug", "key", "_id", "__typename"],
    "hostFieldAliases": {
      "enabled": true,
      "camelCase": true,
      "fields": {
        "titleLine1": "title",
        "title1": "title",
        "heading": "title",
        "headline": "title",
        "mainTitle": "title",
        "sectionTitle": "title",
        "titleHighlighted": "titleHighlight",
        "highlightTitle": "titleHighlight",
        "highlightedTitle": "titleHighlight",
        "highlightText": "titleHighlight",
        "subTitle": "subtitle",
        "subHeading": "subtitle",
        "subheading": "subtitle",
        "tagline": "pretitle",
        "eyebrow": "pretitle",
        "kicker": "pretitle",
        "preTitle": "pretitle",
        "descr": "description",
        "desc1": "description",
        "paragraph": "description",
        "content_text": "description",
        "img": "image",
        "photo": "image",
        "picture": "image",
        "thumbnail": "image",
        "thumb": "image",
        "cover": "image",
        "imgUrl": "image",
        "imageUrl": "image",
        "imageSrc": "image",
        "bg": "backgroundImage",
        "background": "backgroundImage",
        "bgImg": "backgroundImage",
        "bgImageUrl": "backgroundImage",
        "bannerImage": "backgroundImage",
        "heroImage": "backgroundImage",
        "logoImg": "logoImage",
        "logoUrl": "logoImage",
        "logoSrc": "logoImage",
        "socials": "socialLinks",
        "social": "socialLinks",
        "copyright": "copyrightText",
        "copyrightLabel": "copyrightText",
        "btnText": "buttonText",
        "btnLabel": "buttonText",
        "buttonLabel": "buttonText",
        "btnUrl": "buttonUrl",
        "btnLink": "buttonUrl",
        "buttonLink": "buttonUrl",
        "buttonHref": "buttonUrl",
        "btn": "button",
        "faqs": "faqItems",
        "questions": "faqItems",
        "reviews": "testimonials",
        "counters": "stats"
      },
      "bySectionType": {
        "Gallery": { "items": "galleryItems", "images": "galleryItems", "photos": "galleryItems", "gallery": "galleryItems" },
        "GalleryPage": { "items": "galleryItems", "images": "galleryItems", "photos": "galleryItems" },
        "WhyChooseUs": { "items": "whyChooseUsItems", "features": "whyChooseUsItems", "reasons": "whyChooseUsItems", "points": "whyChooseUsItems" },
        "Stats": { "items": "stats", "stat": "stats" },
        "FAQ": { "items": "faqItems" },
        "FAQPage": { "items": "faqItems" },
        "Testimonial": { "items": "testimonials" },
        "Awards": { "awards": "awardItems" },
        "Process": { "items": "steps", "process": "steps", "processSteps": "steps" },
        "Features": { "items": "features" },
        "Team": { "items": "members", "team": "members", "teamMembers": "members" },
        "Partners": { "items": "partners", "brands": "partners", "logos": "partners", "clients": "partners" },
        "Header": { "links": "menu", "navLinks": "menu", "navItems": "menu", "menuItems": "menu", "navigation": "menu" }
      }
    },
    "injectCssVars": { "enabled": false, "styleId": "theme-upload-css-vars" },
    "hostAssetMapper": {
      "enabled": true,
      "importPath": "../../../lib/restaurantFoodAssets",
      "importName": "mapThemeUploadAssetsInData"
    }
  },

  "assets": {
    "optimizeImages": {
      "enabled": true,
      "maxWidth": 1920,
      "jpegQuality": 80,
      "webpQuality": 80,
      "avifQuality": 60,
      "pngPalette": true,
      "pngQuality": 85,
      "minBytes": 10240
    }
  },

  "validation": {
    "maxFileSizeMB": 25,
    "requireAtLeastOneComponent": true,
    "forbiddenExtensions": [".exe", ".dll", ".bat", ".cmd", ".ps1", ".sh", ".msi"]
  },

  "themeJson": {
    "multiPageType": "Multiple Pages Website",
    "singlePageType": "Single Page Website",
    "previewImagePreference": ["banner", "hero", "home", "slider"],
    "addons": {
      "floating.json": { "floatingItems": [] }
    }
  }
}
